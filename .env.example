# URL Base de la aplicación
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# ==============================================================================
# 💳 MERCADO PAGO (Pasarela Principal para Chile y Latinoamérica)
# Obtener en: https://www.mercadopago.cl/developers/panel/app
# ==============================================================================
MERCADOPAGO_ACCESS_TOKEN="APP_USR-..."
MP_WEBHOOK_SECRET="..."

# ==============================================================================
# 🗄️ SUPABASE (Base de Datos y Realtime)
# Obtener en: https://app.supabase.com/project/_/settings/api
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://tu-proyecto.supabase.co"
SUPABASE_SERVICE_ROLE_KEY="tu-service-role-key"

# ==============================================================================
# 💳 STRIPE (Opcional si se opera con entidad internacional)
# Obtener en: https://dashboard.stripe.com/apikeys
# ==============================================================================
STRIPE_SECRET_KEY="sk_test_..."
STRIPE_WEBHOOK_SECRET="whsec_..."

# ==============================================================================
# 📬 RESEND (Motor de Correos Transaccionales y Devocionales)
# Obtener en: https://resend.com/api-keys
# ==============================================================================
RESEND_API_KEY="re_..."
RESEND_FROM_EMAIL="Cielo Santo <paz@cielosanto.com>"

# ==============================================================================
# ⏱️ CRON SECRET
# ==============================================================================
CRON_SECRET="clave_secreta_para_cron"

# Debe contener al menos 32 caracteres aleatorios. Protege enlaces privados de descarga y gestión.
DOWNLOAD_TOKEN_SECRET="reemplazar-por-un-secreto-aleatorio-de-al-menos-32-caracteres"
